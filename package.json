{
  "name": "ipchat",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "reset-admin": "node server/scripts/reset-admin.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
