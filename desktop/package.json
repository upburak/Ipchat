{
  "name": "ipchat-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dist": "node scripts/prepare-bundle.js && electron-builder --win",
    "dist:mac": "node scripts/prepare-bundle.js && electron-builder --mac"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/main.js",
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ipchat.desktop",
    "productName": "Ipchat",
    "files": [
      "src/**/*",
      "assets/**/*",
      "bundle/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "asar": false,
    "mac": {
      "target": "zip",
      "category": "public.app-category.social-networking",
      "identity": null,
      "icon": "assets/icon.png"
    }
  },
  "description": "Ipchat masaüstü uygulaması",
  "author": "Ipchat",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "socket.io": "^4.8.1"
  }
}
